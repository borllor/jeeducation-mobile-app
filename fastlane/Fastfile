require "securerandom"

default_platform(:ios)

APP_IDENTIFIER = "com.jeeducation.app"

platform :ios do
  desc "Build the iOS app and upload it to TestFlight"
  lane :beta do
    # ---------------------------------------------------------------------
    # Why manual signing instead of Xcode automatic signing:
    # xcodebuild's automatic signing ALWAYS provisions an "iOS App Development"
    # profile when archiving, which requires at least one registered device
    # ("Your team has no devices..."). Manually specifying an Apple Distribution
    # identity on top of automatic signing is rejected as a conflict.
    # So we create a real distribution certificate + App Store provisioning
    # profile through the App Store Connect API (no Mac, no CSR, no devices),
    # then archive with manual signing.
    # ---------------------------------------------------------------------

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      in_house: false
    )

    team_id = ENV.fetch("APPLE_TEAM_ID")

    # A dedicated keychain so the distribution certificate can be imported
    # headlessly on the CI runner.
    keychain_name = "ci.keychain"
    keychain_password = SecureRandom.hex(16)
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )
    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}-db")

    # Creates (or reuses) an "Apple Distribution" certificate via the API.
    # fastlane generates the CSR itself, so no macOS Keychain interaction needed.
    get_certificates(
      api_key: api_key,
      keychain_path: keychain_path,
      keychain_password: keychain_password
    )

    # Creates the App Store provisioning profile. App Store profiles do NOT
    # require any registered devices — this is what unblocks the build.
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      force: true
    )

    # Read the profile name/UUID from fastlane's lane context (reliable), not
    # from a guessed ENV key. get_provisioning_profile populates these.
    profile_name = lane_context[SharedValues::SIGH_NAME]
    profile_uuid = lane_context[SharedValues::SIGH_UUID]
    UI.user_error!("No provisioning profile name from sigh") if profile_name.to_s.empty?

    # Switch the App target off automatic signing and point it at the profile
    # we just created.
    update_code_signing_settings(
      path: "ios/App/App.xcodeproj",
      use_automatic_signing: false,
      team_id: team_id,
      bundle_identifier: APP_IDENTIFIER,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: ["App"]
    )

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: ENV["RUNNER_TEMP"] || "build",
      output_name: "JE-Education.ipa",
      clean: false,
      # Version/build number and the iPhone X (iOS 13.0) deployment target.
      # NOTE: do NOT put PROVISIONING_PROFILE_SPECIFIER here — the profile name
      # can contain spaces (e.g. "com.jeeducation.app AppStore 1784862513"),
      # which xcodebuild would parse as extra build actions. The manual profile
      # is already written into the project by update_code_signing_settings above.
      xcargs: [
        "IPHONEOS_DEPLOYMENT_TARGET=#{ENV.fetch('IPHONEOS_DEPLOYMENT_TARGET', '13.0')}",
        "MARKETING_VERSION=#{ENV.fetch('MARKETING_VERSION', '1.0.0')}",
        "CURRENT_PROJECT_VERSION=#{ENV.fetch('GITHUB_RUN_NUMBER', '1')}",
        # iPhone only (UIDeviceFamily = [1]). Drops iPad support so App Store
        # Connect no longer requires iPad screenshots. No Apple Watch target exists.
        "TARGETED_DEVICE_FAMILY=1"
      ].join(" "),
      export_options: {
        method: "app-store",
        teamID: team_id,
        signingStyle: "manual",
        provisioningProfiles: {
          APP_IDENTIFIER => profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true
    )
  end
end
